{
	"compilerOptions": {
		"outDir": ".millennium/Dist",
		"module": "ESNext",
		"target": "ES2020",
		"jsx": "react-jsx",
		"declaration": false,
		"moduleResolution": "node",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"useUnknownInCatchVariables": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	}
}
